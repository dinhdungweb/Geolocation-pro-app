{% comment %}
  Geolocation - Theme App Extension.
  Storefront decisions are resolved by the app proxy. The browser only renders
  the returned action and reports signed analytics events.
{% endcomment %}

{% assign geo_visitor_country = request.country.iso_code | default: localization.country.iso_code | default: "" %}
{% assign geo_market_handle = localization.market.handle | default: "" %}
{% assign geo_market_id = localization.market.id | default: "" %}
{% capture geo_analytics_url %}/apps/geolocation/analytics?shop={{ shop.permanent_domain | url_encode }}{% endcapture %}

<script>
  window.__GEOLOCATION_CONFIG__ = {
    shop: {{ shop.permanent_domain | json }},
    proxyUrl: "/apps/geolocation/config",
    analyticsUrl: {{ geo_analytics_url | json }},
    visitorCountry: {{ geo_visitor_country | json }},
    marketHandle: {{ geo_market_handle | json }},
    marketId: {{ geo_market_id | json }}
  };
</script>
<script src="{{ 'geolocation.js' | asset_url }}" async></script>

{% schema %}
{
  "name": "Geolocation",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "Use the app embed toggle above to enable redirects, country blocking, IP rules, and popups. Configure rules in the app admin."
    }
  ]
}
{% endschema %}
