# Core application
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geolocation_app?schema=public
SHOPIFY_API_KEY=replace_with_shopify_api_key
SHOPIFY_API_SECRET=replace_with_shopify_api_secret
SHOPIFY_APP_URL=https://app.example.com
SCOPES=read_markets,read_orders,read_themes,write_orders
SHOPIFY_BILLING_TEST=true

# Internal administration
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$base64_salt$base64_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
APP_ENCRYPTION_KEY=replace_with_at_least_32_random_characters

# Geolocation and VPN/proxy detection
MAXMIND_LICENSE_KEY=
# Preferred structured IP reputation endpoint. Use {ip} where the provider expects
# the address in the URL path. VPN_CHECK_API_URL remains a backward-compatible fallback.
IP_RISK_API_URL=https://proxycheck.io/v2/{ip}?vpn=1&risk=1
IP_RISK_PROVIDER=proxycheck
IP_RISK_API_KEY=
IP_RISK_FALLBACK_API_URL=https://api.abuseipdb.com/api/v2/check?ipAddress={ip}&maxAgeInDays=30
IP_RISK_FALLBACK_PROVIDER=abuseipdb
IP_RISK_FALLBACK_API_KEY=
IP_RISK_STRICTNESS=1
IP_RISK_BLOCK_MEDIUM=false
IP_RISK_TIMEOUT_MS=1200
IP_RISK_TOTAL_TIMEOUT_MS=2500
IP_RISK_CLEAN_TTL_MS=86400000
IP_RISK_RISK_TTL_MS=3600000
IP_RISK_FAILURE_TTL_MS=60000
VPN_CHECK_API_URL=
GEO_DEBUG_IP=false

# Email
RESEND_API_KEY=
SENDER_EMAIL=

# Runtime workers
DISABLE_IN_APP_CRON=true
ENABLE_IN_APP_CRON=false
DISABLE_ANALYTICS_QUEUE_WORKER=false

# Optional tuning
ANALYTICS_TOKEN_TTL_MS=1800000
STOREFRONT_CONFIG_CACHE_TTL_MS=15000
LOG_RETENTION_DAYS=7
ORDER_RISK_RETENTION_DAYS=60
BILLABLE_EVENT_RETENTION_DAYS=35

# Operations
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=14
HEALTHCHECK_URL=http://127.0.0.1:3001/healthz
HEALTHCHECK_TIMEOUT_MS=10000
HEALTHCHECK_FAILURE_THRESHOLD=2
HEALTHCHECK_STATE_FILE=./.runtime/healthcheck-state.json
ALERT_WEBHOOK_URL=
